{
  "name": "stroke-prediction-system-ai-ml",
  "private": true,
  "version": "1.0.0",
  "description": "Stroke prediction system with a Flask API and React frontend",
  "scripts": {
    "setup:python": "python3 -m venv .venv && . .venv/bin/activate && python -m pip install --upgrade pip && pip install -r requirements.txt",
    "setup:frontend": "npm --prefix neuropredict-frontend install --no-audit --no-fund",
    "setup": "npm run setup:root && npm run setup:python && npm run setup:frontend",
    "dev:backend": ". .venv/bin/activate && python backend.py",
    "predev:frontend": "npm --prefix neuropredict-frontend install --no-audit --no-fund",
    "dev:frontend": "npm --prefix neuropredict-frontend start",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix neuropredict-frontend run build",
    "precheck": "npm --prefix neuropredict-frontend install --no-audit --no-fund",
    "check": "python3 -m compileall . && npm run check:model && npm --prefix neuropredict-frontend run build",
    "test:frontend": "npm --prefix neuropredict-frontend test -- --watch=false",
    "check:model": ". .venv/bin/activate && python ml/test_model_sanity.py",
    "train:model": ". .venv/bin/activate && python ml/train_stroke_model.py",
    "verify:model": ". .venv/bin/activate && python ml/verify_model.py",
    "setup:root": "npm install --no-audit --no-fund"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18",
    "python": ">=3.10 <3.13"
  }
}
